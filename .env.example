# ---------------------------------------------------------------------------
# Raízes API - variáveis de ambiente
# Copie para .env antes de executar:  cp .env.example .env
# ---------------------------------------------------------------------------

# Ambiente: development | test | production
ENVIRONMENT=development
DEBUG=true

# Banco de dados
# SQLite (padrão, roda sem servidor)
DATABASE_URL=sqlite:///./raizes.db
# PostgreSQL (troque e o resto do código continua igual)
# DATABASE_URL=postgresql+psycopg://raizes:raizes@localhost:5432/raizes

# Segurança - gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Pagamento mock - percentual de aprovação automática (0-100)
MOCK_PAYMENT_APPROVAL_RATE=100
